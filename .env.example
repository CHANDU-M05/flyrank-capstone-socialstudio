# Copy to .env and fill in what you need. Never commit the real .env.
#
# Everything here has a safe default: the project runs without a .env at all.

# --- application -----------------------------------------------------------
APP_NAME=Social Media Studio
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite file relative to the working directory. Any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./studio.db

# --- operational endpoint guard -------------------------------------------
# /ops/run-due is DISABLED while this is empty. Set at least 8 characters to enable it,
# then send it as `X-Ops-Token: <value>` (or `Authorization: Bearer <value>`).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_TOKEN=

# --- Telegram (the only real publishing target) ----------------------------
# Leave TELEGRAM_ENABLED=false to run entirely on the deterministic mocks.
TELEGRAM_ENABLED=false
# Bot token from @BotFather. Placeholder only — put the real value in .env, never here.
TELEGRAM_BOT_TOKEN=
# Target chat or channel id, e.g. -1001234567890 for a channel.
TELEGRAM_CHAT_ID=
# true = build and validate the request, then abort before the network call.
TELEGRAM_DRY_RUN=true
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10

# --- scheduler and retries -------------------------------------------------
SCHEDULER_POLL_SECONDS=5
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=900
# A claim older than this is treated as abandoned and returned to the queue.
STALE_CLAIM_SECONDS=900

# --- URL ingestion (SSRF-guarded) -----------------------------------------
INGEST_TIMEOUT_SECONDS=5
INGEST_MAX_BYTES=2000000
INGEST_MAX_REDIRECTS=3
